# Copy to  C:\Users\<you>\.wslconfig  then run  wsl --shutdown  in PowerShell.
#
# Note the path: this is your WINDOWS username, which is usually not the
# same as your Linux username inside the distro.
#
# Two settings here are load-bearing, and both fail in ways that do not
# mention the setting.

[wsl2]

# --- memory ---------------------------------------------------------------
# WSL2 does NOT give Docker your physical RAM. It takes a default share and
# the rest is invisible to the cluster. Without this, pods get OOMKilled
# forty minutes into an install for no apparent reason.
#
# WSL also grows into whatever you allow it and is slow to hand it back, so
# size for the tier you are ACTUALLY running, not the one you might run
# later. Raise it when you move up. Leave Windows at least 6-8GB.
#
#   tier 0 only                     memory=10GB
#   tier 0 and 1, 24GB physical     memory=16GB
#   tier 2, 32GB physical           memory=24GB
#
# Tier 2 on a 24GB machine is possible but tight - expect swapping.
memory=10GB
swap=8GB

# processors= is deliberately omitted. Left out, WSL gets all your cores.
# Setting it to a small number is a downgrade you will forget you made.

# --- cgroup v2 ------------------------------------------------------------
# Kubernetes 1.36 does not run on cgroup v1, and WSL2 before v2.5.1
# defaults to v1. Without this line, `kind create cluster` gets through
# certificates and static pod manifests, then dies at "Starting
# control-plane" with 60 seconds of retries and "context deadline
# exceeded". The only hint is one deprecation warning at the very top of
# several hundred lines of output.
#
# Harmless to leave in on WSL >= 2.5.1, which is already v2.
# Check yours with:  wsl --version
kernelCommandLine = cgroup_no_v1=all systemd.unified_cgroup_hierarchy=1

# ---------------------------------------------------------------------------
# NOTE THE SECTION HEADER. autoMemoryReclaim and sparseVhd live under
# [experimental], NOT [wsl2]. Put them in the wrong section and they are
# silently ignored - which looks exactly like "WSL is hoarding my RAM and
# nothing helps".
# ---------------------------------------------------------------------------
[experimental]

# Return cached memory to Windows.
#
#   dropCache  reclaim immediately  <- what you want, and the WSL default
#   gradual    reclaim slowly, when the CPU is idle
#   disabled   never
#
# Do not use `gradual` here. It is slow enough that you will conclude it is
# broken, and it has a known interaction with Docker Desktop's Resource
# Saver that can wedge WSL entirely (microsoft/WSL#11066). Turn Resource
# Saver off as well - see docs/wsl2-setup.md.
autoMemoryReclaim=dropCache

# Keep the virtual disk from growing monotonically as you create and
# destroy clusters. You will destroy a lot of clusters.
sparseVhd=true
