# ---------------------------------------------------------------------------
# Single source of truth for every pinned version in this lab.
# Change versions HERE and nowhere else.
#
# Bump deliberately: do it on a branch, run `make doctor`, then `make up`.
# Lab 08 is literally "upgrade this file and find out what breaks".
# ---------------------------------------------------------------------------

CLUSTER_NAME=kubeflow-lab

# --- Cluster ---------------------------------------------------------------
# Kubeflow 26.03.1 runs CI against kind 0.32+ / Kubernetes 1.36.
# The @sha256 digest is REQUIRED - kindest/node tags are rebuilt per kind
# release and a bare tag will silently give you a mismatched node.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_VERSION=v1.36.4

# --- Kubeflow --------------------------------------------------------------
# Community Distribution uses CalVer (YY.MM[.patch]), ~2 base releases/year
# cut before KubeCon. Community support is best-effort for ~6 months.
# 26.03.1 ships: Pipelines 2.16.1, KServe 0.18.0, Istio 1.30.1,
#                cert-manager 1.20.2, Dex 2.45.1, Knative 1.22.0.
KUBEFLOW_VERSION=26.03.1

# Tier 0 uses the *standalone* Pipelines deployment instead, which moves
# faster than the distribution and has no Istio/Dex dependency.
KFP_STANDALONE_VERSION=2.17.0

# --- Toolbox CLIs ----------------------------------------------------------
# These float until you run `make freeze`, which resolves them and writes
# VERSIONS.lock. Commit the lock file so your teammates get identical tools.
# Tool drift between people is the #1 cause of "works on my machine" in labs.
KUSTOMIZE_VERSION=latest
HELM_VERSION=latest
K9S_VERSION=latest
KFP_SDK_VERSION=latest
